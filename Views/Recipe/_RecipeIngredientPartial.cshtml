@model BakingIt.Models.RecipeIngredient

@{
    // Retrieve the index provided by the parent view
    var i = (int)ViewData["indexRI"];
    // Adjust the template field prefix for correct model binding
    ViewData.TemplateInfo.HtmlFieldPrefix = $"Recipe.RecipeIngredients[{i}]";
}

<tr class="recipeIngredientRow">
    <td>
        <select asp-for="IngredientId" class="form-control" asp-items="ViewBag.PantryIngredients">
            <option value="">-- Select Ingredient --</option>
        </select>
        <span asp-validation-for="IngredientId" class="text-danger"></span>
    </td>
    <td>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </td>
    <td>
        <select asp-for="MeasureId" class="form-control" asp-items="ViewBag.Measures">
            <option value="">-- Select Measure --</option>
        </select>
        <span asp-validation-for="MeasureId" class="text-danger"></span>
    </td>
    <td>
        <!-- Remove Ingredient button for deleting the row -->
        <button type="button" class="btn btn-outline-danger removeIngredientRow">
            <i class="fas fa-trash-alt me-2"></i>Remove Ingredient
        </button>
    </td>
</tr>