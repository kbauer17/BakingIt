@model BakingIt.ViewModels.RecipeViewModel

@{
    ViewBag.Title = "Edit Recipe - " + Model.Recipe.RecipeName;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <h2 class="text-center mb-4">Edit Recipe</h2>

            @if (ViewBag.ModelErrors != null)
            {
                <ul>
                    @foreach (var error in ViewBag.ModelErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <form asp-action="EditRecipe" method="post">
                @Html.AntiForgeryToken()
                <!-- Hidden input for RecipeId -->
                <input type="hidden" asp-for="Recipe.RecipeId" />

                <!-- Recipe Name -->
                <div class="mb-3">
                    <label asp-for="Recipe.RecipeName" class="form-label"></label>
                    <input asp-for="Recipe.RecipeName" class="form-control" />
                    <span asp-validation-for="Recipe.RecipeName" class="text-danger"></span>
                </div>

                <!-- Recipe Instructions -->
                <div class="mb-3">
                    <label asp-for="Recipe.Instructions" class="form-label"></label>
                    <textarea asp-for="Recipe.Instructions" class="form-control"></textarea>
                    <span asp-validation-for="Recipe.Instructions" class="text-danger"></span>
                </div>

                <!-- Recipe Ingredients -->
                <h3 class="d-flex">
                    Ingredients
                    <button type="button" id="addRecipeIngredientButton" class="btn btn-accent ms-auto">
                        <i class="fas fa-plus me-2"></i>Add Ingredient
                    </button>
                </h3>
                <table id="RecipeIngredientsTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ingredient</th>
                            <th>Quantity</th>
                            <th>Measure</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Recipe.RecipeIngredients.Count; i++)
                        {
                            <partial name="_RecipeIngredientPartial" for="@Model.Recipe.RecipeIngredients[i]" 
                                    view-data="@(new ViewDataDictionary(ViewData) { { "indexRI", i } })" />
                        }
                    </tbody>
                </table>
                <div class="mt-3 d-flex">
                    <a asp-controller="Recipe" asp-action="RecipeDetails" asp-route-id="@Model.Recipe.RecipeId" class="btn btn-return-outline me-2">Cancel and Return to Recipe Details</a>
                    <button type="submit" class="btn btn-submit">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // Initialize the DataTable on the RecipeIngredients table.
            var table = $('#RecipeIngredientsTable').DataTable({
                paging: false,
                columnDefs: [
                    { targets: [1,2,3], orderable: false}    
                ]
            });

            // Determine the starting row index based on current table rows.
            var rowIndex = table.rows().count();

            // Handler to add new ingredient row via AJAX.
            $("#addRecipeIngredientButton").on("click", function (e) {
                e.preventDefault();

                $.get("/Recipe/GetRecipeIngredientPartial", { indexRI: rowIndex }, function (data) {
                    // Add the new row to DataTable.
                    table.row.add($(data)).draw();
                    rowIndex++;
                });
            });

            // Delegate removal event for dynamically added rows.
            $('#RecipeIngredientsTable tbody').on("click", ".removeIngredientRow", function () {
                var row = $(this).closest("tr");
                table.row(row).remove().draw();
            });

            // add to the submittal routine to reindex the list.  If a Remove occurred, the index may have gaps which the model binder may treat the collection as empty
            $("form").on("submit", function () {
                // Re-index the RecipeIngredients
                var newIndex = 0;
                $("#RecipeIngredientsTable tbody tr").each(function () {
                    // For each input/select/textarea in this row update the name attributes.
                    $(this).find("input, select, textarea").each(function () {
                        var name = $(this).attr("name");
                        if (name) {
                            // Replace the current index in the name with the new contiguous index.
                            // This uses a regex to replace Recipe.RecipeIngredients[N] with the new index.
                            var updatedName = name.replace(/Recipe\.RecipeIngredients\[\d+\]/, "Recipe.RecipeIngredients[" + newIndex + "]");
                            $(this).attr("name", updatedName);
                        }
                    });
                    newIndex++;
                });
            });
        });
    </script>
}