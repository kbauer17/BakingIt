@model BakingIt.ViewModels.RecipeViewModel
@{
    ViewBag.Title = "Create Recipe";
}

<h2>@ViewBag.Title</h2>
<hr />
@if (ViewBag.ModelErrors != null)
{
    <ul>
        @foreach (var error in ViewBag.ModelErrors)
        {
            <li>@error</li>
        }
    </ul>
}
<div class="row">
    <div class="col-md-12">
        <form asp-action="CreateRecipe" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="form-group col-sm-6">
                    <label asp-for="Recipe.RecipeName"></label>
                    <input asp-for="Recipe.RecipeName" class="form-control" />
                    <span asp-validation-for="Recipe.RecipeName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="form-group col-sm-12">
                    <label asp-for="Recipe.Instructions"></label>
                    <textarea asp-for="Recipe.Instructions" class="form-control"></textarea>
                    <span asp-validation-for="Recipe.Instructions" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-3">
                Ingredients
                <button type="button" id="addRecipeIngredientButton" class="btn btn-primary mb-2" novalidate>
                    <i class="fas fa-plus pr-2"></i>Add Ingredient to Recipe
                </button>
            </h3>
            <fieldset id="RecipeIngredients">
                
                @for (int i = 0; i < Model.Recipe.RecipeIngredients.Count; i++)
                {
                    <partial name="_RecipeIngredientPartial" for="@Model.Recipe.RecipeIngredients[i]" view-data="@(new ViewDataDictionary(ViewData) { {"indexRI", i} })" />
                }
                
            </fieldset>

            <button type="submit" class="btn btn-success mt-3">Save Recipe</button>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // use ajax to access a controller getter method for displaying the _AliasPartial.cshtml upon a button click by the user
        var indexRi = $('#RecipeIngredients').children('.recipeIngredients').length; 
                console.log("Initial indexRi:", indexRi);
        $("#addRecipeIngredientButton").on("click", function (e) {
            e.preventDefault();
            @* var viewPatientDetails = $('#ViewPatientDetails').val();
                console.log("viewPatientDetails:", viewPatientDetails); *@
            $.get("/Recipe/GetRecipeIngredientPartial", 
                { 
                    indexRi: indexRi, 
                    @* viewPatientDetails: viewPatientDetails  *@
                }, 
                function (data) {
                    console.log("Received data:", data);
                $("#RecipeIngredients").append(data);
                indexRi++;
                    console.log("Updated indexRi: ", indexRi);
            });
        });
    </script>
}