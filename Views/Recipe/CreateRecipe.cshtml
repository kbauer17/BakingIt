@model BakingIt.ViewModels.RecipeViewModel
@{
    ViewBag.Title = "Create Recipe";
}

<h2>@ViewBag.Title</h2>

@if (ViewBag.ModelErrors != null)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewBag.ModelErrors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="CreateRecipe" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="form-group col-sm-6">
                    <label asp-for="Recipe.RecipeName" class="form-label"></label>
                    <input asp-for="Recipe.RecipeName" class="form-control" required/>
                    <span asp-validation-for="Recipe.RecipeName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="form-group col-sm-12">
                    <label asp-for="Recipe.Instructions" class="form-label"></label>
                    <textarea asp-for="Recipe.Instructions" class="form-control"></textarea>
                    <span asp-validation-for="Recipe.Instructions" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-3 d-flex">
                Ingredients
                <button type="button" id="addRecipeIngredientButton" class="btn btn-accent ms-auto">
                    <i class="fas fa-plus me-2"></i>Add Ingredient
                </button>
            </h3>
            
            <table id="RecipeIngredientsTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th>Quantity</th>
                        <th>Measure</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Recipe.RecipeIngredients.Count; i++)
                    {
                        <partial name="_RecipeIngredientPartial" for="@Model.Recipe.RecipeIngredients[i]" 
                                 view-data="@(new ViewDataDictionary(ViewData) { { "indexRI", i } })" />
                    }
                </tbody>
            </table>
            
            <div class="mt-3 d-flex">
                <a asp-controller="Recipe" asp-action="ViewRecipes" class="btn btn-return-outline me-2" >Cancel and Return to Recipe List</a>
                <button type="submit" class="btn btn-submit">
                    <i class="fas fa-save me-2"></i>Save Recipe
                </button>
                <button type="reset" class="btn btn-accent-outline ms-auto">Clear Form</button>
            </div>
            
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Ensure that both jQuery and DataTables JS/CSS are included (e.g., in your layout) -->
    <script>
        $(document).ready(function () {
            // Initialize the DataTable on the ingredients table.
            var table = $('#RecipeIngredientsTable').DataTable({
                paging: false,
                ordering: false,
                searching: false,
                scrollY: '200px',   // Sets table body height with vertical scrolling
                scrollCollapse: true    // Allows the table to collapse if fewer than the expected rows exist
            });
            var rowIndex = table.rows().count();

            $("#addRecipeIngredientButton").on("click", function (e) {
                e.preventDefault();
                
                $.get("/Recipe/GetRecipeIngredientPartial", { indexRI: rowIndex }, function (data) {
                    // Convert the return data to a jQuery object and filter only <tr> elements
                    var $newRowElement = $(data).filter("tr");

                    if(!$newRowElement.length){
                        console.error("Partial view did not return a valid <tr> element");
                    }
                    
                    // Append the new row markup to the DataTable.
                    var newRow = table.row.add($newRowElement).draw(false).node();
                    rowIndex++;

                    // Scroll to a new row within the table's scrolling container only.
                    var $scrollBody = $('#RecipeIngredientsTable_wrapper .dataTables_scrollBody');

                    // Calculate the position of the new row relative to the scroll container.
                    var newRowPosition = $(newRow).position().top;
                    $scrollBody.animate({
                        scrollTop: newRowPosition - 20  // adjust offset for UI elements like header
                    }, 500);    // scroll animation duration in milliseconds
                });
            });

            // Delegate event listener for removing an ingredient row
            $('#RecipeIngredientsTable').on("click", ".removeIngredientRow", function () {
                var row = $(this).closest("tr");
                table.row(row).remove().draw(false);
            });
        });
    </script>
}