@model BakingIt.Models.Measure
@{
    ViewBag.Title = "Create Measure";
}
 
<h1>@ViewBag.Title</h1>

<div class="row">
    <div class="col-md-12">
        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="MeasureId" value="@Model.MeasureId" readonly />
                <div class="form-group col-sm-6">
                    <label asp-for="MeasureName" class="form-label"></label>
                    <input type="text" asp-for="MeasureName" class="form-control" maxlength="100" required placeholder="Example:  Gallon"/>
                    <span asp-validation-for="MeasureName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="MeasureAbbreviation" class="form-label"></label>
                        <input type="text" asp-for="MeasureAbbreviation" class="form-control" required placeholder="Example:  gal"/>
                        <span asp-validation-for="MeasureAbbreviation" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <a asp-controller="Measure" asp-action="ViewMeasures" class="btn btn-return-outline mb-3" >Cancel and Return to Measure List</a>
                <input type="submit" value="Save Changes" class="btn btn-submit mb-3" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}