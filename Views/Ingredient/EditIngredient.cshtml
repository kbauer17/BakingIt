@model BakingIt.Models.Ingredient
@{
    ViewBag.Title = "Edit Ingredient";
}
 
<h1>@ViewBag.Title</h1>

<div class="row">
    <div class="col-md-12">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IngredientId" value="@Model.IngredientId" readonly />
                <div class="form-group col-sm-6">
                    <label asp-for="IngredientName" class="form-label"></label>
                    <input type="text" asp-for="IngredientName" class="form-control" maxlength="255"  placeholder="Example:  Flour"/>
                    <span asp-validation-for="IngredientName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="PurchaseQuantity" class="form-label"></label>
                        <input type="number" step="0.01" min="0" asp-for="PurchaseQuantity" class="form-control" placeholder="Example:  12"/>
                        <span asp-validation-for="PurchaseQuantity" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="MeasureId" class="form-label"></label>
                        <select asp-for="MeasureId" asp-items="ViewBag.Measures" class="form-control">
                            <option value="">--Select--</option></select>
                        <span asp-validation-for="MeasureId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="PurchaseCost" class="form-label"></label>
                        <input type="number" step="0.01" min="0" asp-for="PurchaseCost" class="form-control" placeholder="Example:  7.99"/>
                        <span asp-validation-for="PurchaseCost" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <a class="btn btn-return-outline" asp-controller="Ingredient" asp-action="ViewIngredients">Discard Changes</a>
                <input type="submit" value="Save Changes" class="btn btn-submit" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}