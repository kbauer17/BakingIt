@model BakingIt.Models.Ingredient
@{
    ViewBag.Title = "Create Ingredient";
}
 
<h1>@ViewBag.Title</h1>
<hr />

<div class="row">
    <div class="col-md-12">
        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group col-sm-6">
                    <label asp-for="IngredientName" class="form-label"></label>
                    <input type="text" asp-for="IngredientName" class="form-control" maxlength="255" required placeholder="Example:  Flour"/>
                    <span asp-validation-for="IngredientName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="PurchaseQuantity" class="form-label"></label>
                        <input type="number" step="0.01" min="0" asp-for="PurchaseQuantity" class="form-control" required placeholder="Example:  12"/>
                        <span asp-validation-for="PurchaseQuantity" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="MeasureId" class="form-label"></label>
                        <select asp-for="MeasureId" asp-items="ViewBag.Measures" class="form-control" required>
                            <option value="">--Select--</option></select>
                        <span asp-validation-for="MeasureId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label asp-for="PurchaseCost" class="form-label"></label>
                        <input type="number" step="0.01" min="0" asp-for="PurchaseCost" class="form-control" required placeholder="Example:  7.99"/>
                        <span asp-validation-for="PurchaseCost" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <a asp-controller="Ingredient" asp-action="ViewIngredients" class="btn btn-outline-warning mb-3" >Cancel and Return to Ingredient List</a>
                <input type="submit" value="Create New Ingredient" class="btn btn-primary mb-3" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}