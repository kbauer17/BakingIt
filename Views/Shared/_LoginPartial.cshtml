@using Microsoft.AspNetCore.Identity;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if(SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="UserManagement" asp-action="Index">Administration</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="" asp-action="">    <!-- could be a link for the User to update their profile  -->
                Hello @UserManager.GetUserName(User)!
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
        </li>
    }
</ul>

