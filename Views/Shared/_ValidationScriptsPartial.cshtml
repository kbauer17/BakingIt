@* Use this file whenever a view requires validation by adding it to the Scripts section like this:
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
        -- other <scripts> here --
    }
 *@

@* Set JavaScript variables with the correct script paths *@
<script type="text/javascript">
    var jQueryPath = '@Url.Content("~/lib/jquery/dist/jquery.min.js")';
    var jQueryValidatePath = '@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")';
    var jQueryValidateUnobtrusivePath = '@Url.Content("~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js")';
</script>

<script type="text/javascript">
    @* this little portion of the script is used by controllers doing validation and Bootstrap to highlight properties which are invalid  *@
    function applyValidationStyles() {
        document.querySelectorAll("input").forEach((elem) => {
            if (elem.classList.contains("input-validation-error")) {
                elem.classList.add("is-invalid"); // Apply Bootstrap styling
            } else if (!elem.classList.contains("input-validation-error")) {
                elem.classList.remove("is-invalid"); // Remove Bootstrap styling when valid
            }
        });
    }

    // Run the function when the page loads
    window.addEventListener("DOMContentLoaded", applyValidationStyles);

    // Reapply styles when validation updates (on change, blur, form validation)
    document.addEventListener("change", applyValidationStyles);
    document.addEventListener("blur", applyValidationStyles);

    // If using jQuery validation, listen for dynamic updates
    $(document).ready(function () {
        $("form").on("submit keyup blur", "input", function () {
            applyValidationStyles(); // Reapply styles dynamically
        });
    });

    // Function to load a script dynamically, works in both Development and Production environments
    // Checks to see if the script is already loaded, most likely from within _Layout.cshtml, by the current page
    function loadScript(url, integrity, crossorigin) {
        var script = document.createElement('script');
        script.src = url;
        if (integrity) {
            script.integrity = integrity;
        }
        if (crossorigin) {
            script.crossOrigin = crossorigin;
        }
        document.head.appendChild(script);
    }

    window.addEventListener("DOMContentLoaded", () => {
        if (window.jQuery) {
            console.log("jQuery is loaded:", jQuery.fn.jquery);
            
            if (!window.jQuery.validator) {
                console.log("Loading jQuery validation...");
                loadScript('@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")');
            }

            if (!window.jQuery.validator.unobtrusive) {
                console.log("Loading jQuery unobtrusive validation...");
                loadScript('@Url.Content("~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js")');
            }
        } else {
            console.error("jQuery is NOT loaded correctly!");
        }
    });
</script>