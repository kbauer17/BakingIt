@{
    ViewData["Title"] = "Home Page";
}

<div class="container d-flex flex-column align-items-center mt-4">
    <h3 class="text-center w-50">Welcome to BakingIt! <br> Select an Action:</h3>
    
    <a asp-controller="Ingredient" asp-action="ViewIngredients" class="card w-50 text-center text-decoration-none">
        <div class="card-body">
            <h5 class="card-title">Ingredients</h5>
            <p class="card-text">Click here to add or update Ingredients</p>
        </div>
    </a>
    

    <a asp-controller="Recipe" asp-action="ViewRecipes" class="card w-50 text-center text-decoration-none mt-3">
        <div class="card-body">
            <h5 class="card-title">Recipes</h5>
            <p class="card-text">Click here to add or update Recipes</p>
        </div>
    </a>

    <a asp-controller="Conversion" asp-action="ViewConversions" class="card w-50 text-center text-decoration-none mt-3">
        <div class="card-body">
            <h5 class="card-title">Conversions</h5>
            <p class="card-text">Click here to add or update Conversions.</p>
        </div>
    </a>
</div>
